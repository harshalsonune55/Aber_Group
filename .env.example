# Copy to .env and fill in. NEVER commit .env.

# --- Application ---
ABER_ENV=development                 # development | staging | production
ABER_DEBUG=true
ABER_LOG_LEVEL=INFO
ABER_LOG_JSON=false                  # true in production (Loki ingests JSON)
ABER_API_PREFIX=/api/v1
ABER_CORS_ORIGINS=["http://localhost:3000"]

# --- Database ---
# Async driver for the API, sync driver for Alembic and Celery workers.
ABER_DATABASE_URL=postgresql+asyncpg://aber:aber@localhost:5432/aber
ABER_DATABASE_URL_SYNC=postgresql+psycopg://aber:aber@localhost:5432/aber
ABER_DB_POOL_SIZE=10
ABER_DB_MAX_OVERFLOW=20
ABER_DB_ECHO=false

# --- Redis (Celery broker + cache + SSE fan-out) ---
ABER_REDIS_URL=redis://localhost:6379/0
ABER_CELERY_BROKER_URL=redis://localhost:6379/1
ABER_CELERY_RESULT_BACKEND=redis://localhost:6379/2

# --- Auth ---
# ES256 keypair. Generate with:
#   openssl ecparam -genkey -name prime256v1 -noout -out jwt_private.pem
#   openssl ec -in jwt_private.pem -pubout -out jwt_public.pem
ABER_JWT_PRIVATE_KEY_PATH=./secrets/jwt_private.pem
ABER_JWT_PUBLIC_KEY_PATH=./secrets/jwt_public.pem
ABER_JWT_ALGORITHM=ES256
ABER_JWT_ISSUER=aber-api
ABER_ACCESS_TOKEN_TTL_MINUTES=15
ABER_REFRESH_TOKEN_TTL_DAYS=30

# --- Encryption (AES-GCM for bank IBAN, ID numbers) ---
# 32 random bytes, base64. Generate with:
#   python3 -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
ABER_FIELD_ENCRYPTION_KEY=

# --- Audit chain (Ed25519 daily anchors) ---
# Generate with:
#   openssl genpkey -algorithm ed25519 -out audit_signing.pem
ABER_AUDIT_SIGNING_KEY_PATH=./secrets/audit_signing.pem
ABER_AUDIT_SIGNING_KEY_ID=v1

# --- Object storage (MinIO / S3) ---
ABER_S3_ENDPOINT_URL=http://localhost:9000
ABER_S3_ACCESS_KEY=minioadmin
ABER_S3_SECRET_KEY=minioadmin
ABER_S3_REGION=me-central-1
ABER_S3_BUCKET_DOCUMENTS=aber-documents
ABER_S3_BUCKET_MEDIA=aber-media
ABER_S3_PRESIGN_TTL_SECONDS=900

# --- Odoo ---
ABER_ODOO_URL=http://localhost:8069
ABER_ODOO_DB=aber
ABER_ODOO_USERNAME=aber_integration
ABER_ODOO_API_KEY=
ABER_ODOO_WEBHOOK_SECRET=            # shared HMAC secret, must match the addon setting
ABER_ODOO_TIMEOUT_CONNECT=5
ABER_ODOO_TIMEOUT_READ=30
ABER_ODOO_BREAKER_FAIL_MAX=5
ABER_ODOO_BREAKER_RESET_SECONDS=60
ABER_ODOO_SYNC_ENABLED=false         # keep false until M2
ABER_ODOO_SYNC_LEADS=false           # V1 non-goal, see docs/adr/0004

# --- Notifications ---
ABER_FCM_CREDENTIALS_PATH=
ABER_SMTP_HOST=localhost
ABER_SMTP_PORT=1025
ABER_SMTP_FROM=no-reply@abergroup.ae

# --- Observability ---
ABER_SENTRY_DSN=
ABER_METRICS_ENABLED=true
